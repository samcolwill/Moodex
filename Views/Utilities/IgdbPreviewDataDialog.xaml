<Window x:Class="Moodex.Views.Utilities.IgdbPreviewDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IGDB: Preview Game Data"
        Icon="/Moodex;component/Assets/icon/icon.ico"
        Height="320" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Review the data fetched from IGDB. Click Accept to apply or Cancel to discard."
                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,0,6"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" Margin="0,4,0,6"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Genres:" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,0,6"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GenresDisplay}" TextWrapping="Wrap" Margin="0,4,0,6"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Release Date:" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,0,6"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReleaseDateDisplay}" Margin="0,4,0,6"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Summary:" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,0,6"/>
        <ScrollViewer Grid.Row="4" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,6">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
        </ScrollViewer>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" IsCancel="True" Width="75" Margin="0,0,8,0"/>
            <Button Content="Accept" IsDefault="True" Click="Accept_Click" Width="75"/>
        </StackPanel>
    </Grid>
</Window>
