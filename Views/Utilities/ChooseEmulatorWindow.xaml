<Window x:Class="Moodex.Views.Utilities.ChooseEmulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Moodex.Converters"
        Title="Choose Emulator"
        Height="260" Width="520"
        WindowStartupLocation="CenterOwner"
        Icon="/Moodex;component/Assets/icon/icon.ico"
        Background="White"
        Foreground="Black">

    <Window.Resources>
        <conv:ExecutableToIconConverter x:Key="IconConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Message}" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Option A -->
            <Button Grid.Column="0" Margin="0,0,8,0" Padding="8" Height="120" HorizontalContentAlignment="Left" Click="SelectA_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Width="48" Height="48" Margin="0,0,12,0"
                           Source="{Binding EmulatorA.ExecutablePath, Converter={StaticResource IconConverter}}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding EmulatorA.Name}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding EmulatorA.ExecutablePath}" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Option B -->
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="8" Height="120" HorizontalContentAlignment="Left" Click="SelectB_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Width="48" Height="48" Margin="0,0,12,0"
                           Source="{Binding EmulatorB.ExecutablePath, Converter={StaticResource IconConverter}}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding EmulatorB.Name}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding EmulatorB.ExecutablePath}" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>


