<Window x:Class="Moodex.Views.Utilities.IgdbPreviewCoverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IGDB: Preview Cover"
        Icon="/Moodex;component/Assets/icon/icon.ico"
        Height="420" Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Preview the cover image from IGDB. Click Accept to apply or Cancel to discard."
                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,10"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="CoverImage" Stretch="Uniform" MaxHeight="300" MaxWidth="264"/>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" IsCancel="True" Width="75" Margin="0,0,8,0"/>
            <Button Content="Accept" IsDefault="True" Click="Accept_Click" Width="75"/>
        </StackPanel>
    </Grid>
</Window>
