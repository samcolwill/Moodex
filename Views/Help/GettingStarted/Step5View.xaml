<UserControl x:Class="Moodex.Views.Help.GettingStarted.Step5View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="5. Get playing" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                Moodex lets you track how you play — not just what you play.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
                For each game, you can mark completion status such as:
            </TextBlock>
            <StackPanel Margin="12,6,0,0">
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">• Any%</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">• Max Difficulty</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">• 100% Completion</TextBlock>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
                You can also track achievements and revisit completed games at any time. This makes it easy to see what you’ve finished, what you’re working on, and what’s next.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                Once everything is set up, just click a game and start playing.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.85">Enjoy 🎮</TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>


