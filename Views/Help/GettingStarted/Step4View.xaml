<UserControl x:Class="Moodex.Views.Help.GettingStarted.Step4View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="4. Right-click menu" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                Every game tile in Moodex includes a powerful right-click menu for quick actions and organization.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">From here, you can:</TextBlock>
            <StackPanel Margin="12,6,0,0">
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">• Run the game</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">• Edit game details</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">• Delete the game from your library</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">• Archive / Restore games</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">• Open the file location</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">• Manage Scripts</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">• Configure Controller settings</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">• Track Achievements</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">• Mark Completion status</TextBlock>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                These options let you manage your collection without leaving the library view.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.85">Next: Tracking progress and completion</TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>


